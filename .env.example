# Redis stream cache (docker compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_PREFIX=pubsub

# ChromaDB (docker compose service on port 8000)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=kimi_embeddings

# Embedding model (used for BOTH ingest and query — keep them identical)
EMBED_MODEL=all-MiniLM-L6-v2

# Dataset bulk seed (scripts/load_dataset_to_chroma.py)
# IMPORTANT: set HF_TOKEN for the bulk load. Unauthenticated HF streaming is
# rate-limited (~2-3 MB/s) and the first parquet shard can stall the run for minutes;
# a token raises limits so wall-clock tracks compute (~140 docs/s) not the network.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
DATASET_NAME=ianncity/KIMI-K2.5-1000000x
DATASET_SUBSET=General-Distillation
DATASET_SPLIT=train
MAX_DOCS=30000          # tune for a ~45-min run; ~199000 = literal 50% of the subset
BATCH_SIZE=256

# Streaming embed worker (scripts/embed_worker.py)
EMBED_CHANNEL=embeddings

# RAG app LLM (app/streamlit_app.py) — auto-selected from API keys:
#   GEMINI_API_KEY set → Gemini; otherwise → Ollama (local or OLLAMA_API_KEY)

# Ollama (default when GEMINI_API_KEY is empty)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_API_KEY=              # optional; Bearer token for Ollama Cloud / authenticated hosts

# Gemini (used when GEMINI_API_KEY is set — takes precedence)
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
